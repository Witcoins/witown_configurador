{
  "//": "El target directivos NO está en .firebaserc a propósito: así un firebase deploy por error no reemplaza la demo que hoy está en vivo en directivos-iwitown. Para probar: npm run canal (vista previa, 30 días). Se mapea de verdad solo en la Fase 6.",
  "hosting": {
    "target": "directivos",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/config/**", "function": { "functionId": "configuradorPublico", "region": "us-central1" } },
      { "source": "/api/horas", "function": { "functionId": "landingHoras", "region": "us-central1" } },
      { "source": "/api/agendar", "function": { "functionId": "landingAgendar", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://www.ecosistema.iwitown.com https://ecosistema.iwitown.com https://ecosistema-iwitown.web.app https://ecosistema-iwitown.firebaseapp.com" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
